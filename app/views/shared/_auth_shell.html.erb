<%# locals: (active_tab: nil, title: nil) %>
<div class="min-h-screen flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-5xl bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col lg:flex-row">
    <div class="lg:w-[45%] bg-primary p-8 lg:p-12 flex flex-col justify-between min-h-[280px] lg:min-h-[640px]">
      <div>
        <%= render "shared/logo", link: root_path, class_name: "bg-white px-3 py-1 rounded-lg inline-block" %>
      </div>
      <div class="mt-10 lg:mt-0">
        <h1 class="font-heading text-3xl lg:text-4xl font-bold text-white leading-tight">Plan Every Event with Ease.</h1>
        <p class="font-body text-white/80 mt-4 text-base lg:text-lg">Connecting Hosts with Extraordinary Verified Vendors.</p>
      </div>
    </div>

    <div class="lg:w-[55%] p-8 lg:p-12 flex flex-col justify-center">
      <% if active_tab.present? %>
        <div class="flex rounded-lg bg-gray-100 p-1 mb-8 shadow-sm">
          <%= link_to "Login", login_path, class: auth_tab_class(active_tab == :login) %>
          <%= link_to "Sign Up", signup_path, class: auth_tab_class(active_tab == :signup) %>
        </div>
      <% elsif title.present? %>
        <h2 class="font-heading text-2xl font-semibold text-charcoal mb-8"><%= title %></h2>
      <% end %>

      <%= yield %>
    </div>
  </div>
</div>
