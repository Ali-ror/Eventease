<% if notice.present? %>
  <div class="bg-primary/10 border border-primary/20 text-charcoal text-sm font-body px-4 py-3 text-center" role="status">
    <%= notice %>
  </div>
<% end %>

<% if alert.present? %>
  <div class="bg-red-50 border border-red-200 text-red-800 text-sm font-body px-4 py-3 text-center" role="alert">
    <%= alert %>
  </div>
<% end %>
