<div class="min-h-screen flex items-center justify-center px-4 py-10 bg-cream">
  <div class="w-full max-w-5xl bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col lg:flex-row">
    <div class="lg:w-[45%] bg-primary p-8 lg:p-12 flex flex-col justify-between min-h-[280px] lg:min-h-[640px]">
      <div>
        <p class="inline-block font-body text-xs font-semibold tracking-wide uppercase text-white bg-white/15 border border-white/25 px-3 py-1 rounded-full mb-6">
          AUTHORIZED PERSONNEL ONLY
        </p>
        <%= render "shared/logo", link: root_path, class_name: "bg-white px-3 py-1 rounded-lg inline-block" %>
      </div>
      <div class="mt-10 lg:mt-0">
        <h1 class="font-heading text-3xl lg:text-4xl font-bold text-white leading-tight">Admin Control Panel</h1>
        <p class="font-body text-white/80 mt-4 text-base lg:text-lg">Secure access for EventEase administrators.</p>
      </div>
    </div>

    <div class="lg:w-[55%] p-8 lg:p-12 flex flex-col justify-center bg-cream/40">
      <%= yield %>
    </div>
  </div>
</div>
