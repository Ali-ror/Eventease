<header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="shrink-0">
      <%= render "shared/logo", link: dashboard_path %>
    </div>

    <div class="flex-1 max-w-xl mx-auto w-full">
      <input
        type="search"
        placeholder="Search vendors..."
        class="w-full rounded-lg border border-gray-200 px-4 py-2 text-sm font-body text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
        aria-label="Search vendors"
      />
    </div>

    <div class="flex flex-wrap items-center justify-end gap-3 shrink-0">
      <div class="flex items-center rounded-full border border-gray-200 bg-white p-1 shadow-sm">
        <%= button_to "Host", session_view_mode_path(view_mode: "host"), method: :patch, class: role_toggle_class(current_view_mode == "host"), form: { class: "inline" } %>
        <%= button_to "Vendor", session_view_mode_path(view_mode: "vendor"), method: :patch, class: role_toggle_class(current_view_mode == "vendor"), form: { class: "inline" } %>
      </div>

      <%= link_to "Notifications", notifications_path, class: "text-sm font-body font-medium text-charcoal border border-gray-200 rounded-lg px-4 py-2 hover:border-primary hover:text-primary transition shadow-sm" %>

      <details class="relative group">
        <summary class="list-none cursor-pointer flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-body font-medium text-charcoal hover:border-primary shadow-sm [&::-webkit-details-marker]:hidden">
          <span><%= current_user.first_name %></span>
          <span class="text-gray-500 text-xs">Menu</span>
        </summary>
        <div class="absolute right-0 mt-2 w-44 rounded-lg border border-gray-200 bg-white shadow-lg py-1 z-50">
          <%= link_to "My Profile", "#", class: "block px-4 py-2 text-sm font-body text-charcoal hover:bg-cream transition" %>
          <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm font-body text-charcoal hover:bg-cream transition", form: { class: "block" } %>
        </div>
      </details>
    </div>
  </div>
</header>
