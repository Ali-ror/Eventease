<%= render layout: "shared/auth_shell", locals: { active_tab: :signup } do %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: signup_path, html: { class: "space-y-5" }) do |f| %>
    <div>
      <%= f.label :name, "Full Name", class: "block text-sm font-medium font-body text-charcoal mb-1.5" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Enter your full name", class: "w-full rounded-lg border border-gray-200 px-4 py-2.5 font-body text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" %>
    </div>

    <div>
      <%= f.label :email, "Email", class: "block text-sm font-medium font-body text-charcoal mb-1.5" %>
      <%= f.email_field :email, autocomplete: "email", placeholder: "Enter your email", class: "w-full rounded-lg border border-gray-200 px-4 py-2.5 font-body text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" %>
    </div>

    <div>
      <%= f.label :password, "Password", class: "block text-sm font-medium font-body text-charcoal mb-1.5" %>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "Create a password", class: "w-full rounded-lg border border-gray-200 px-4 py-2.5 font-body text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium font-body text-charcoal mb-1.5" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm your password", class: "w-full rounded-lg border border-gray-200 px-4 py-2.5 font-body text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary" %>
    </div>

    <%= f.submit "Create Account", class: "w-full bg-primary text-white font-body font-semibold py-3 rounded-lg hover:bg-primary/90 transition shadow-sm cursor-pointer" %>
  <% end %>

  <p class="text-center text-sm font-body text-gray-600 mt-6">
    Already have an account?
    <%= link_to "Login", login_path, class: "text-primary font-medium hover:text-primary/80 transition" %>
  </p>
<% end %>
